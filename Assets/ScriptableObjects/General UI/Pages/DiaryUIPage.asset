  pageColor: {r: 1, g: 1, b: 1, a: 0.78431374}
  header:
    text: Hemiunu's Diary
    textColor: {r: 0, g: 0, b: 0, a: 1}
  body:
    text: "We got a lot done today. Taghrid, the farmer I\u2019ve mentioned before,
      came up with the brilliant idea of using the river nearby to float blocks of
      limestone down to the construction site. It worked well. His Majesty Huni would
      be delighted."
    textColor: {r: 0, g: 0, b: 0, a: 1}
